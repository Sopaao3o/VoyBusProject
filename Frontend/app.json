{
  "expo": {
    "name": "VoyBus",
    "slug": "voybus",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "voybus",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "VoyBus usa tu ubicación para centrar el mapa donde estás."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "VoyBus usa la cámara para leer el código QR de la micro en que vas.",
          "recordAudioAndroid": false
        }
      ],
      "expo-audio"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
