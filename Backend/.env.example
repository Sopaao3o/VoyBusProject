# Copia este archivo como .env y ajusta los valores. El .env NO se sube al repo.
PORT=3000

# Ruta del archivo SQLite.
DB_PATH=./data/voybus.db

# ACC-01: firma de los tokens JWT. Cambia este valor fuera de desarrollo.
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# Coste del hash de contraseñas (bcrypt). 10 es un buen valor local.
BCRYPT_ROUNDS=10

# Minutos de validez del código que verifica el correo o teléfono.
CODIGO_VERIFICACION_MINUTOS=15

# ACC-02: tras varios intentos fallidos de inicio de sesión, la cuenta espera un tiempo.
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MINUTOS=15
LOGIN_BLOQUEO_MINUTOS=5

# ACC-04: minutos de validez del enlace temporal para recuperar la contraseña.
RECUPERACION_EXPIRA_MINUTOS=30

# ACC-01/ACC-02: minutos de validez del desafío que pide el código de la app autenticadora.
DOS_FACTORES_MINUTOS=5

# ACC-01: segundos de espera entre dos reenvíos del código de verificación al mismo contacto.
REENVIO_ESPERA_SEGUNDOS=60

# Solo en producción (NODE_ENV=production): no se cargan los usuarios de demostración.
# Con estos dos valores se crea el primer administrador al iniciar con la base vacía.
# ADMIN_CORREO=admin@tu-empresa.cl
# ADMIN_PASSWORD=una-contraseña-larga-y-única

# ACC-01/ACC-02: inicio de sesión con Google (gratis). Ver "Inicio de sesión con Google" en el README.
# Sin estos tres valores el botón de Google avisa que no está configurado; lo demás funciona igual.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dirección HTTPS con la que Google llega a este backend (la del túnel de ngrok), sin "/" al final.
URL_PUBLICA=

# Solo en desarrollo: al arrancar, pone 4 micros de demostración en circulación (BUS-02 a BUS-05)
# para ver el mapa con vehículos en vivo. También se puede iniciar y detener desde la app.
SIMULAR_FLOTA=0

# Red de transporte que se carga con la base vacía (o con npm run db:reset):
#   antofagasta = líneas reales con trazado por las calles (requiere generar el catálogo una vez
#                 con npm run catalogo:antofagasta; si no existe, se usa la de prueba)
#   prueba      = red pequeña de demostración (la que usan las pruebas automáticas)
CATALOGO=antofagasta

# Servicio de rutas para trazar recorridos por las calles (ADM-01). Por defecto, el servidor
# público y gratuito de OSRM. Solo cámbialo si tienes uno propio.
# OSRM_URL=https://router.project-osrm.org
