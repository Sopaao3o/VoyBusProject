# Copia este archivo como .env y ajusta los valores. El .env NO se sube al repo.
PORT=3000

# Ruta del archivo SQLite.
DB_PATH=./data/voybus.db

# ACC-01: firma de los tokens JWT. Cambia este valor fuera de desarrollo.
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# Coste del hash de contraseñas (bcrypt). 10 es un buen valor local.
BCRYPT_ROUNDS=10

# Minutos de validez del código que verifica el correo o teléfono.
CODIGO_VERIFICACION_MINUTOS=15
