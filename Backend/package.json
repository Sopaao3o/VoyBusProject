{
  "name": "voybus-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de VoyBus (Node.js + Express + SQLite)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrar": "node src/database/run.js",
    "db:reset": "node src/database/run.js --reset",
    "test": "node --test \"test/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "morgan": "^1.12.1",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1",
    "umzug": "^3.8.3",
    "zod": "^4.6.7"
  }
}
